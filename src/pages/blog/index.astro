---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articulos = (await getCollection('blog'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const destacado = articulos.find(a => a.data.destacado);
const resto = articulos.filter(a => !a.data.destacado);

const categorias = [...new Set(articulos.map(a => a.data.categoria))];
---

<Base
  titulo="Blog Legal | GSM Soluciones Jurídicas · Quetzaltenango"
  descripcion="Artículos y guías legales para Guatemala. Información clara sobre derecho civil, laboral, penal y trámites notariales en Quetzaltenango."
>

<style>
  .blog-dest {
    background: var(--negro-alt); border: 0.5px solid var(--oro-borde);
    padding: 48px 40px; display: grid;
    grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
    margin-bottom: 1px;
  }
  .dest-badge {
    display: inline-block; font-size: 9px; letter-spacing: 3px;
    text-transform: uppercase; color: var(--negro);
    background: var(--oro); padding: 4px 12px; margin-bottom: 20px;
  }
  .dest-titulo {
    font-family: var(--serif); font-size: clamp(24px,3.5vw,36px);
    font-weight: 300; line-height: 1.2; color: var(--blanco); margin-bottom: 16px;
  }
  .dest-titulo em { font-style: italic; color: var(--oro); }
  .dest-texto { font-size: 13px; color: var(--gris); line-height: 1.85; font-weight: 300; margin-bottom: 28px; }
  .dest-visual {
    background: var(--negro-card); border: 0.5px solid var(--oro-tenue);
    height: 100%; min-height: 220px;
    display: flex; align-items: center; justify-content: center;
  }
  .dest-num { font-family: var(--serif); font-size: 120px; color: rgba(201,168,76,0.07); font-weight: 300; line-height: 1; }

  .categorias { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 32px; }
  .cat-btn {
    font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
    padding: 7px 16px; border: 0.5px solid var(--oro-borde);
    color: var(--gris); background: transparent; cursor: pointer;
    transition: all .2s;
  }
  .cat-btn:hover, .cat-btn.activo { background: var(--oro); color: var(--negro); border-color: var(--oro); }

  .articulos-grid {
    display: grid; grid-template-columns: repeat(3,1fr);
    gap: 1px; background: var(--oro-tenue);
  }
  .art-card {
    background: var(--negro-alt); padding: 36px 28px;
    display: flex; flex-direction: column; transition: background .2s;
  }
  .art-card:hover { background: var(--negro-card); }
  .art-cat {
    font-size: 9px; letter-spacing: 3px; text-transform: uppercase;
    color: var(--oro); margin-bottom: 14px;
    display: flex; align-items: center; gap: 8px;
  }
  .art-cat::before { content: ''; width: 16px; height: 0.5px; background: var(--oro); }
  .art-titulo {
    font-family: var(--serif); font-size: clamp(17px,2vw,20px);
    font-weight: 400; color: var(--blanco); line-height: 1.3;
    margin-bottom: 12px; flex-grow: 1;
  }
  .art-desc { font-size: 12px; color: var(--gris); line-height: 1.8; font-weight: 300; margin-bottom: 20px; }
  .art-meta {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 16px; border-top: 0.5px solid rgba(255,255,255,0.06);
    font-size: 11px; color: rgba(255,255,255,0.25);
  }
  .art-leer { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--oro); }

  @media(max-width:900px){
    .blog-dest { grid-template-columns: 1fr; }
    .dest-visual { display: none; }
    .articulos-grid { grid-template-columns: 1fr 1fr; }
  }
  @media(max-width:600px){ .articulos-grid { grid-template-columns: 1fr; } }
</style>

<header class="page-hero">
  <div class="eyebrow">Blog jurídico</div>
  <h1>Información legal<br><em>de valor</em> para nuestros usuarios</h1>
  <p class="page-hero-sub">Artículos escritos por nuestros Abogados para orientarle en sus derechos y asuntos.</p>
</header>

<!-- DESTACADO -->
{destacado && (
  <section class="seccion">
    <div class="eyebrow">Artículo destacado</div>
    <a href={`/blog/${destacado.slug}`} class="blog-dest">
      <div>
        <div class="dest-badge">✦ Destacado</div>
        <h2 class="dest-titulo">{destacado.data.titulo}</h2>
        <p class="dest-texto">{destacado.data.descripcion}</p>
        <span class="btn-oro">Leer artículo</span>
      </div>
      <div class="dest-visual" aria-hidden="true">
        <div class="dest-num">01</div>
      </div>
    </a>
  </section>
)}

<!-- TODOS LOS ARTÍCULOS -->
<section class="seccion seccion-alt">
  <div class="eyebrow">Todos los artículos</div>
  <h2 class="titulo-seccion">Guías para <em>Quetzaltenango</em></h2>

  <div class="categorias">
    <button class="cat-btn activo">Todos</button>
    {categorias.map(c => <button class="cat-btn">{c}</button>)}
  </div>

  <div class="articulos-grid">
    {resto.map(a => (
      <a href={`/blog/${a.slug}`} class="art-card">
        <div class="art-cat">{a.data.categoria}</div>
        <h3 class="art-titulo">{a.data.titulo}</h3>
        <p class="art-desc">{a.data.descripcion}</p>
        <div class="art-meta">
          <span>{a.data.fecha.toLocaleDateString('es-GT', { year:'numeric', month:'long' })}</span>
          <span class="art-leer">Leer →</span>
        </div>
      </a>
    ))}
  </div>
</section>

</Base>
