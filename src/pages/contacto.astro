---
import Base from '../layouts/Base.astro';
---

<Base
  titulo="Contacto | GSM Soluciones Jurídicas · Quetzaltenango, Xela"
  descripcion="Contáctenos para agendar su consulta jurídica en Quetzaltenango. Oficina en Edificio Solares, Of. 406. Tel: 4292 3804 / 3627 5880. Atención presencial y virtual."
>

<style>
  .contacto-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 1px; background: var(--oro-tenue); margin-top: 48px; }
  .contacto-info { background: var(--negro-alt); padding: 48px 40px; }
  .contacto-form-bloque { background: var(--negro-card); padding: 48px 40px; }
  .info-item { margin-bottom: 36px; }
  .info-item:last-child { margin-bottom: 0; }
  .info-etiqueta { font-size: 9px; letter-spacing: 4px; text-transform: uppercase; color: var(--oro); margin-bottom: 10px; display: flex; align-items: center; gap: 8px; }
  .info-etiqueta::before { content: ''; width: 16px; height: 0.5px; background: var(--oro); }
  .info-valor { font-size: 14px; color: var(--blanco); font-weight: 300; line-height: 1.7; }
  .info-valor a { color: var(--blanco); transition: color .2s; }
  .info-valor a:hover { color: var(--oro); }
  .wa-buttons { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; }
  .wa-btn { display: flex; align-items: center; gap: 12px; background: rgba(37,211,102,0.07); border: 0.5px solid rgba(37,211,102,0.25); padding: 13px 18px; font-size: 13px; color: #4dde85; font-weight: 300; transition: background .2s; }
  .wa-btn:hover { background: rgba(37,211,102,0.13); }
  .wa-btn svg { width: 18px; height: 18px; fill: #25D366; flex-shrink: 0; }
  .horario-tabla { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
  .horario-fila { display: flex; justify-content: space-between; font-size: 13px; color: var(--gris); font-weight: 300; padding-bottom: 8px; border-bottom: 0.5px solid rgba(255,255,255,0.05); }
  .horario-fila:last-child { border-bottom: none; }
  .horario-fila span:last-child { color: var(--blanco); }
  .form-titulo { font-family: var(--serif); font-size: clamp(22px,3vw,28px); font-weight: 300; color: var(--blanco); margin-bottom: 6px; }
  .form-titulo em { font-style: italic; color: var(--oro); }
  .form-sub { font-size: 13px; color: var(--gris); font-weight: 300; margin-bottom: 32px; line-height: 1.7; }
  .form-grupo { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
  .form-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.35); }
  .form-input { background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); color: var(--blanco); padding: 13px 16px; font-size: 14px; font-family: var(--sans); font-weight: 300; outline: none; transition: border-color .2s; width: 100%; }
  .form-input:focus { border-color: var(--oro); }
  .form-input::placeholder { color: rgba(255,255,255,0.15); }
  .form-select { background: rgba(255,255,255,0.04); border: 0.5px solid rgba(255,255,255,0.1); color: var(--blanco); padding: 13px 16px; font-size: 14px; font-family: var(--sans); font-weight: 300; outline: none; width: 100%; appearance: none; cursor: pointer; transition: border-color .2s; }
  .form-select:focus { border-color: var(--oro); }
  .form-select option { background: var(--negro-alt); }
  .form-textarea { resize: vertical; min-height: 110px; }
  .form-fila { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form-aviso { font-size: 11px; color: rgba(255,255,255,0.2); margin-top: 12px; line-height: 1.6; font-weight: 300; }
  .form-submit { width: 100%; margin-top: 4px; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--negro); background: var(--oro); border: none; padding: 15px 28px; cursor: pointer; font-family: var(--sans); font-weight: 500; transition: background .2s; }
  .form-submit:hover { background: var(--oro-claro); }
  .form-exito { display: none; background: rgba(201,168,76,0.07); border: 0.5px solid var(--oro-borde); padding: 28px; text-align: center; margin-top: 20px; }
  .form-exito p { font-family: var(--serif); font-size: 20px; color: var(--oro); font-style: italic; font-weight: 300; }
  .form-exito small { font-size: 12px; color: var(--gris); display: block; margin-top: 8px; }
  .mapa-iframe { width: 100%; height: 380px; border: none; display: block; filter: grayscale(1) invert(0.85) contrast(0.9); opacity: 0.7; }
  .mapa-overlay { background: var(--negro-alt); border-top: 0.5px solid var(--oro-borde); padding: 20px var(--px); display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .mapa-dir { font-size: 13px; color: var(--gris); font-weight: 300; flex: 1; }
  .mapa-dir strong { color: var(--blanco); font-weight: 400; display: block; margin-bottom: 2px; }
  @media(max-width:768px){ .contacto-grid { grid-template-columns: 1fr; } .form-fila { grid-template-columns: 1fr; } .contacto-info, .contacto-form-bloque { padding: 36px 24px; } }
</style>

<header class="page-hero">
  <div class="eyebrow">Contáctenos</div>
  <h1>Agende su <em>cita</em><br>en Quetzaltenango</h1>
  <p class="page-hero-sub">Atendemos de manera presencial en nuestra oficina de Xela o por videollamada si se encuentra fuera de la ciudad.</p>
</header>

<section class="seccion">
  <div class="contacto-grid">
    <div class="contacto-info">
      <div class="eyebrow">Información de contacto</div>
      <div class="info-item">
        <div class="info-etiqueta">Dirección</div>
        <div class="info-valor">0 Avenida 8-85, Zona 7<br/>Edificio Solares, Oficina 406<br/><strong>Quetzaltenango, Guatemala</strong></div>
      </div>
      <div class="info-item">
        <div class="info-etiqueta">Teléfono</div>
        <div class="info-valor"><a href="tel:+50242923804">4292 3804</a><br/><a href="tel:+50236275880">3627 5880</a></div>
      </div>
      <div class="info-item">
        <div class="info-etiqueta">WhatsApp directo</div>
        <div class="wa-buttons">
          <a href="https://wa.me/50242923804?text=Hola%2C%20me%20interesa%20una%20consulta%20jur%C3%ADdica" target="_blank" rel="noopener" class="wa-btn">
            <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            4292 3804
          </a>
          <a href="https://wa.me/50236275880?text=Hola%2C%20me%20interesa%20una%20consulta%20jur%C3%ADdica" target="_blank" rel="noopener" class="wa-btn">
            <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            3627 5880
          </a>
        </div>
      </div>
      <div class="info-item">
        <div class="info-etiqueta">Horario de atención</div>
        <div class="horario-tabla">
          <div class="horario-fila"><span>Lunes a viernes</span><span>8:30 – 17:00</span></div>
          <div class="horario-fila"><span>Sábados</span><span>9:30 – 13:30</span></div>
          <div class="horario-fila"><span>Domingos</span><span>Solo emergencias</span></div>
        </div>
      </div>
      <div class="info-item">
        <div class="info-etiqueta">Modalidad</div>
        <div class="info-valor" style="font-size:13px;">
          ✦ Presencial — Oficina 406, Edificio Solares, Xela<br/>
          ✦ Virtual — Videollamada por Zoom o Google Meet<br/>
        
        </div>
      </div>
    </div>

    <div class="contacto-form-bloque">
      <h2 class="form-titulo">Cuéntenos su <em>caso</em></h2>
      <p class="form-sub">Complete el formulario y le contactamos para coordinar su cita.</p>
      <form id="contacto-form" novalidate>
        <div class="form-fila">
          <div class="form-grupo">
            <label class="form-label" for="nombre">Nombre completo</label>
            <input class="form-input" type="text" id="nombre" name="nombre" placeholder="Juan Pérez" autocomplete="name" required />
          </div>
          <div class="form-grupo">
            <label class="form-label" for="telefono">Teléfono</label>
            <input class="form-input" type="tel" id="telefono" name="telefono" placeholder="5555 1234" autocomplete="tel" />
          </div>
        </div>
        <div class="form-grupo">
          <label class="form-label" for="correo">Correo electrónico</label>
          <input class="form-input" type="email" id="correo" name="correo" placeholder="correo@ejemplo.com" autocomplete="email" required />
        </div>
        <div class="form-grupo">
          <label class="form-label" for="servicio">Área de consulta</label>
          <select class="form-select" id="servicio" name="servicio">
            <option value="" disabled selected>Seleccione un área</option>
            <option value="notarial">Servicios Notariales / Inmuebles</option>
            <option value="civil">Asuntos Civiles de Familia</option>
            <option value="laboral">Juicios Laborales</option>
            <option value="municipal">Trámites Municipales</option>
            <option value="penal">Derecho Penal</option>
            <option value="voluntaria">Jurisdicción Voluntaria</option>
            <option value="otro">Otro / No estoy seguro</option>
          </select>
        </div>
        <div class="form-grupo">
          <label class="form-label" for="modalidad">Modalidad de consulta</label>
          <select class="form-select" id="modalidad" name="modalidad">
            <option value="" disabled selected>Presencial o virtual</option>
            <option value="presencial">Presencial — Oficina en Xela</option>
            <option value="virtual">Virtual — Videollamada</option>
            <option value="whatsapp">WhatsApp</option>
          </select>
        </div>
        <div class="form-grupo">
          <label class="form-label" for="mensaje">Descripción breve del caso</label>
          <textarea class="form-input form-textarea" id="mensaje" name="mensaje" placeholder="Cuéntenos en pocas palabras qué necesita resolver…"></textarea>
        </div>
        <button type="submit" class="form-submit">Enviar consulta →</button>
        <p class="form-aviso">Sus datos son confidenciales y no se comparten con terceros.</p>
      </form>
      <div class="form-exito" id="form-exito" role="alert">
        <p>Gracias, hemos recibido su consulta.</p>
        <small>Le contactaremos para coordinar su cita.</small>
      </div>
    </div>
  </div>
</section>

<div style="border-top: 0.5px solid var(--oro-borde);">
  <iframe class="mapa-iframe" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3822.1!2d-91.524!3d14.845!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTTCsDUwJzQyLjAiTiA5McKwMzEnMjYuNCJX!5e0!3m2!1ses!2sgt!4v1234567890" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Ubicación GSM Quetzaltenango"></iframe>
  <div class="mapa-overlay">
    <div class="mapa-dir"><strong>GSM Soluciones Jurídicas</strong>0 Avenida 8-85, Zona 7, Edificio Solares, Oficina 406 · Quetzaltenango, Guatemala</div>
    <a href="https://maps.google.com/?q=Edificio+Solares+Quetzaltenango+Guatemala" target="_blank" rel="noopener" class="btn-linea">Abrir en Google Maps</a>
  </div>
</div>

<script>
  document.getElementById('contacto-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const nombre = (document.getElementById('nombre') as HTMLInputElement).value.trim();
    const correo = (document.getElementById('correo') as HTMLInputElement).value.trim();
    if (!nombre || !correo) { alert('Por favor complete su nombre y correo electrónico.'); return; }
    (this as HTMLFormElement).style.display = 'none';
    const exito = document.getElementById('form-exito');
    if (exito) exito.style.display = 'block';
  });
</script>

</Base>
